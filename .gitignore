/android/app/debug
/android/app/profile
/android/app/release

# Machine-specific SDK paths (this machine uses a non-default location to
# work around a Windows NDK/ninja bug with non-ASCII user profile paths)
/android/local.properties

# Widget Preview related
.widget_preview/

# Real API keys — env.example.json is the committed template; copy it to
# env.local.json and fill in GOO_LAB_APP_ID/DEEPL_API_KEY, then run with
# `flutter run --dart-define-from-file=env.local.json`.
env.local.json
